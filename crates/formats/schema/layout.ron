// Ejemplo canónico de TrackLayout.
// El tipo Rust vive en crates/formats/src/layout.rs a partir de la fase 1.
// Stub de forma: un elemento de cada lista, no una pista jugable.
TrackLayout(
    version: 1,
    start_node: 0,
    total_distance: 0.0,
    start_grid: [
        (pos: (x: 0.0, y: 0.5, z: 0.0), yaw: 0.0),
    ],
    zones: [
        TrackZone(
            id: 0,
            center: (x: 0.0, y: 1.0, z: 0.0),
            rotation: (x: 0.0, y: 0.0, z: 0.0, w: 1.0),
            half_extents: (x: 8.0, y: 4.0, z: 6.0),
        ),
    ],
    pos_nodes: [
        PosNode(
            id: 0,
            position: (x: 0.0, y: 0.5, z: 0.0),
            distance: 0.0,
            prev: [],
            next: [],
        ),
    ],
    ai_nodes: [
        AiNode(
            id: 0,
            left: (x: -4.0, y: 0.5, z: 0.0),
            right: (x: 4.0, y: 0.5, z: 0.0),
            racing_t: 0.5,
            overtaking_t: 0.5,
            prev: [],
            next: [],
            flags: Racing,
            speed_limit: None,
        ),
    ],
    pickups: [
        PickupSpawn(
            pos: (x: 12.0, y: 0.6, z: -4.0),
            respawn_secs: 5.0,
            odds: None,
        ),
    ],
    pickup_odds: None,
    force_fields: [
        ForceField(
            id: 0,
            center: (x: 0.0, y: 2.0, z: 80.0),
            rotation: (x: 0.0, y: 0.0, z: 0.0, w: 1.0),
            half_extents: (x: 12.0, y: 8.0, z: 12.0),
            kind: GravityScale(0.35),
        ),
    ],
    surface_effects: None,
    surface_volumes: [],
    param_mods: [],
    kill_volumes: [
        KillVolume(
            center: (x: 0.0, y: -20.0, z: 0.0),
            rotation: (x: 0.0, y: 0.0, z: 0.0, w: 1.0),
            half_extents: (x: 200.0, y: 5.0, z: 200.0),
        ),
    ],
)
